{
  "name": "carreau",
  "version": "0.1.0",
  "private": true,
  "description": "QCM surveillés sur téléphone pour la classe",
  "license": "MIT",
  "author": "Yves Charvis",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 50173",
    "build": "next build",
    "start": "next start -p 50173",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrer.mjs",
    "admin:creer": "node --env-file-if-exists=.env scripts/admin-creer.mjs",
    "admin:reinitialiser-totp": "node --env-file-if-exists=.env scripts/admin-reinitialiser-totp.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "next": "16.3.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "write-excel-file": "^4.1.1"
  }
}
