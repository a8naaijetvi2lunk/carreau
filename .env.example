# Copier en .env et compléter. Aucun secret réel dans ce fichier.
DATABASE_URL=postgres://carreau:carreau@localhost:50170/carreau
DATABASE_URL_TEST=postgres://carreau:carreau@localhost:50171/carreau_test
APP_URL=http://localhost:50173
IMAGES_DIR=./.donnees/images
# Archives de sauvegarde des images (scripts/sauvegarder-images.mjs, prévu pour le conteneur)
SAUVEGARDES_DIR=./.donnees/sauvegardes
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHIFFREMENT_CLE=
# Facultatif : secret de la tâche planifiée des purges (32 caractères minimum, sans espace)
CRON_SECRET=
# Clé des Server Actions, fournie au build et jamais changée ensuite (même commande que CHIFFREMENT_CLE)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
